# Copy to `.env` and fill in. Never commit the real .env — it is gitignored.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Local Docker Postgres with pgvector:
#   docker run -d --name sentellent-db -p 5432:5432 \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=sentellent pgvector/pgvector:pg16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentellent

# --- Session ---------------------------------------------------------------
# Any long random string locally. Generated by Terraform in AWS.
SESSION_SECRET=change-me-to-something-long-and-random

# --- Google OAuth ----------------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# The redirect URI below must match one listed there EXACTLY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_BASE_URL=http://localhost:3000

# --- AI provider -----------------------------------------------------------
# Defaults below need no keys at all: the app runs end to end, but answers are
# retrieval-only. Switch to gemini once you have a key from
# https://aistudio.google.com/apikey
LLM_PROVIDER=echo
EMBEDDING_PROVIDER=hash

# For Gemini (recommended — free tier covers both chat and embeddings):
#   LLM_PROVIDER=gemini
#   EMBEDDING_PROVIDER=gemini
#   GOOGLE_API_KEY=AIza...
GOOGLE_API_KEY=

# For OpenAI:
#   LLM_PROVIDER=openai
#   EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# For Anthropic (pair with gemini/openai embeddings — Anthropic has no
# embeddings model of its own):
#   LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Scheduled refresh -----------------------------------------------------
INTERNAL_REFRESH_TOKEN=local-dev-token
